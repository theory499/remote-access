{
  "rules": {
    "sessions": {
      "$code": {
        ".read": "auth != null && (!data.exists() || data.child('host/uid').val() == auth.uid || data.child('client/uid').val() == auth.uid)",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/)",

        "host": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() == auth.uid || !newData.exists())",
          ".validate": "newData.hasChildren(['uid', 'createdAt']) || !newData.exists()",
          "uid":       { ".validate": "newData.isString() && newData.val() == auth.uid" },
          "createdAt": { ".validate": "newData.val() == now" },
          "$other":    { ".validate": false }
        },

        "client": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() == auth.uid || !newData.exists())",
          ".validate": "newData.hasChildren(['uid', 'createdAt']) || !newData.exists()",
          "uid":       { ".validate": "newData.isString() && newData.val() == auth.uid" },
          "createdAt": { ".validate": "newData.val() == now" },
          "$other":    { ".validate": false }
        },

        "offer": {
          ".write": "auth != null && root.child('sessions/' + $code + '/host/uid').val() == auth.uid",
          ".validate": "newData.hasChild('sdp') && newData.hasChild('type') || !newData.exists()",
          "$other":    { ".validate": false }
        },

        "answer": {
          ".write": "auth != null && root.child('sessions/' + $code + '/client/uid').val() == auth.uid",
          ".validate": "newData.hasChild('sdp') && newData.hasChild('type') || !newData.exists()",
          "$other":    { ".validate": false }
        },

        "iceCandidates": {
          "host": {
            ".write": "auth != null && root.child('sessions/' + $code + '/host/uid').val() == auth.uid",
            ".read":  "auth != null && root.child('sessions/' + $code + '/client/uid').val() == auth.uid",
            "$id":    { ".validate": "newData.hasChild('candidate') || !newData.exists()" }
          },
          "client": {
            ".write": "auth != null && root.child('sessions/' + $code + '/client/uid').val() == auth.uid",
            ".read":  "auth != null && root.child('sessions/' + $code + '/host/uid').val() == auth.uid",
            "$id":    { ".validate": "newData.hasChild('candidate') || !newData.exists()" }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    }
  }
}
